{
  "name": "@local/dsh-omnivision",
  "version": "0.15.3",
  "private": true,
  "type": "module",
  "description": "OmniVision v0.15.3 开源发行版：面向 DeepSeek-V4.1-Flash 原生多模态的全感官桌面伴侣底座（追剧2x2宫格+WASAPI/SenseVoiceSmall、单机游戏硬件扫描码+默认干跑快反射+F12急停、按需局部OCR）。",
  "exports": {
    ".": "./host.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./client": "./client.js"
  },
  "files": [
    "host.js",
    "sidecar/omnivisiond.py",
    "prompts",
    "locale",
    "docs",
    "icon.svg",
    "README.md",
    "cordis.patch.yml",
    "client.js",
    "sidecar"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}